# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only: real project secret key (sb_secret_...) or legacy service_role key.
# Required for private username lookup/password login and maintenance jobs.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Configure Brevo/Gmail SMTP in Supabase Auth; see supabase/AUTH_SETUP.md.
# Only needed if an external HTTP scheduler calls /api/cron. Supabase pg_cron
# can call run_scheduled_maintenance() directly, in which case this is unused.
CRON_SECRET=replace_with_a_long_random_secret

# LiveKit
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-cloud-url.livekit.cloud

# Tenor GIF API
TENOR_API_KEY=your_tenor_api_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
